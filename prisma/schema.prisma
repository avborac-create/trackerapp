// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tek kullanıcılı uygulama: user_id yok, tüm veriler tek çalışma alanına ait.

enum Category {
  companion
  multi
  active
  passive
}

enum ExternalStatus {
  inbox
  not_now
  on_agenda
  closed
}

enum WeekState {
  open
  closed
}

enum TaskList {
  inbox
  task
  buylist
  calendar
}

// done: yapıldı. unexpected: beklenmedik engel (hastalık, seyahat vb. — tamamlanma
// yüzdesinin paydasından da düşülür, aleyhte sayılmaz). neglected: bilinçli ihmal
// (paydada kalır, "yapılmadı" gibi aleyhte sayılır — ama boş bırakmaktan farklı
// olarak niyeti kayıt altına alır).
enum DailyMarkStatus {
  done
  unexpected
  neglected
}

// Gün içi tekil kayıtların türü: success = uygulama anı, failure = başarısız
// olunan/denenip olmayan an. İkisi de aynı günün kayıt listesinde birlikte
// tutulur, sayaç ayrımı bu alana göre yapılır.
enum DailyMarkEntryKind {
  success
  failure
}

model Node {
  id             String         @id @default(cuid())
  title          String
  category       Category       @default(active)
  externalStatus ExternalStatus @default(inbox)
  notes          String? // "Read me": her gün hatırlanması istenen serbest metin
  tags           String[] @default([]) // örn. Multi için "hastane", "haciz", "araba" gibi birden çok bağlam etiketi
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  weekNodes WeekNode[]

  @@map("tracker_nodes")
}

model Week {
  id       String    @id @default(cuid())
  startsOn DateTime
  endsOn   DateTime
  state    WeekState @default(open)

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  weekNodes WeekNode[]

  @@map("tracker_weeks")
}

model WeekNode {
  id     String @id @default(cuid())
  weekId String
  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  nodeId String
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  categorySnapshot Category
  includedOn       DateTime
  removedOn        DateTime?
  sortOrder        Int       @default(0)

  dailyMarks DailyMark[]

  @@unique([weekId, nodeId])
  @@map("tracker_week_nodes")
}

model DailyMark {
  id         String   @id @default(cuid())
  weekNodeId String
  weekNode   WeekNode @relation(fields: [weekNodeId], references: [id], onDelete: Cascade)

  day    DateTime
  status DailyMarkStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries DailyMarkEntry[]

  @@unique([weekNodeId, day])
  @@map("tracker_daily_marks")
}

model DailyMarkEntry {
  id          String    @id @default(cuid())
  dailyMarkId String
  dailyMark   DailyMark @relation(fields: [dailyMarkId], references: [id], onDelete: Cascade)

  text      String
  kind      DailyMarkEntryKind @default(success)
  createdAt DateTime @default(now())

  @@map("tracker_daily_mark_entries")
}

// Basit, sürtünmesiz not/görev yakalama paneli: Inbox / Task / Buylist.
// Calendar ayrı bir liste değildir — herhangi bir öğeye "date" atanınca
// Calendar sayfasında da (kaynak listesiyle birlikte) görünür.
model TaskItem {
  id        String       @id @default(cuid())
  list      TaskList     @default(inbox)
  text      String
  date      String? // opsiyonel YYYY-MM-DD gün etiketi — Calendar'da bu tarihin altında gösterilir
  done      Boolean      @default(false)
  sortOrder Int          @default(0)
  sectionId String?
  section   TaskSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("tracker_task_items")
}

// Todoist'teki "Kısım" (section) karşılığı: bir liste içinde öğeleri alt
// başlıklar altında gruplamak için.
model TaskSection {
  id        String   @id @default(cuid())
  list      TaskList
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  items TaskItem[]

  @@map("tracker_task_sections")
}
